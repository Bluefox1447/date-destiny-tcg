# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///dds.db
# อีเมลที่ใส่ตรงนี้จะได้สิทธิ์ Admin อัตโนมัติเมื่อสมัคร/ล็อคอิน (คั่นด้วย ,)
ADMIN_EMAILS=you@example.com

# ส่งอีเมลรหัสยืนยัน (ถ้าเว้น MAIL_SERVER ไว้ รหัสจะแสดงใน console แทน เหมาะกับตอนทดสอบ)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_SSL=0
MAIL_USERNAME=yourmail@gmail.com
MAIL_PASSWORD=app-password
MAIL_FROM=Date Destiny TCG <yourmail@gmail.com>

# Google OAuth  (Redirect URI: http://localhost:5000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord OAuth (Redirect URI: http://localhost:5000/auth/discord/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# กติกาเด็ค (ปรับได้)
DECK_SIZE=50
MAX_COPIES=4

# ===== เปิดให้เพื่อนเล่นออนไลน์ =====
# อยู่หลัง Cloudflare Tunnel / Render / nginx (ให้เชื่อ https และโดเมนจริง)
BEHIND_PROXY=0
# เปิดผ่าน HTTPS แล้วให้ตั้งเป็น 1
COOKIE_SECURE=0
# 1 = สมัครแล้วใช้ได้ทันทีโดยไม่ส่งรหัสอีเมล (เหมาะกับกลุ่มเพื่อนส่วนตัว)
SKIP_EMAIL_VERIFY=0
# โฟลเดอร์เก็บรูปการ์ด/Sleeve ถาวร (เช่นดิสก์ที่เมาต์บนโฮสต์) ถ้าเว้นไว้ใช้ static/uploads
UPLOAD_DIR=
# ฐานข้อมูลจริง เช่น postgresql://user:pass@host/dbname (เว้นไว้ = SQLite ในเครื่อง)
# DATABASE_URL=
# ปิดโหมด debug เสมอเมื่อเปิดให้คนอื่นใช้ (1 = เปิด ใช้เฉพาะตอนพัฒนา)
FLASK_DEBUG=0

# ===== ส่งอีเมลบน Render แผนฟรี =====
# Render ฟรีบล็อกพอร์ต SMTP (25/465/587) ทำให้ Gmail SMTP ใช้ไม่ได้ ให้ใช้ Brevo ผ่าน HTTPS แทน (ฟรี ~300 ฉบับ/วัน)
# 1) สมัคร brevo.com  2) Senders > เพิ่มและยืนยันอีเมลผู้ส่ง  3) SMTP & API > สร้าง API key (v3)
# BREVO_API_KEY=xkeysib-xxxxxxxx
# MAIL_FROM_EMAIL=อีเมลผู้ส่งที่ยืนยันใน Brevo แล้ว
# MAIL_FROM_NAME=Date Destiny TCG
